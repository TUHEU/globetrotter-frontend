server {
    listen 8106;
    listen [::]:8106;
    server_name _;

    root /var/www/globetrotter-frontend/dist;
    index index.html;

    client_max_body_size 20m;  # photo/media uploads

    location = /health { proxy_pass http://127.0.0.1:8105; }
    location = /metrics { proxy_pass http://127.0.0.1:8105; }
    location = /recommendations { proxy_pass http://127.0.0.1:8105; }
    location = /docs { proxy_pass http://127.0.0.1:8105; }
    location = /openapi.json { proxy_pass http://127.0.0.1:8105; }

    location ~ ^/(auth|preferences|users|destinations|favorites|itineraries|routing|media|assistant|rooms|recommendations)(/|$) {
        proxy_pass http://127.0.0.1:8105;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /ws/ {
        proxy_pass http://127.0.0.1:8105;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri /index.html;
    }
}
