server {
    listen 8106;
    listen [::]:8106;
    server_name _;

    root /var/www/globetrotter-frontend/dist;
    index index.html;

    client_max_body_size 20m;  # photo/media uploads

    location = /health { proxy_pass http://127.0.0.1:8105; }
    location = /metrics { proxy_pass http://127.0.0.1:8105; }
    location = /recommendations { proxy_pass http://127.0.0.1:8105; }
    location = /docs { proxy_pass http://127.0.0.1:8105; }
    location = /openapi.json { proxy_pass http://127.0.0.1:8105; }

    # BUG FIX - "the page breaks on reload" / raw JSON shown for a direct
    # visit to /destinations or /favorites
    # -----------------------------------------------------------------
    # /destinations and /favorites are BOTH real backend API path prefixes
    # (see itinerary-service's routers) AND real React Router page routes
    # in this SPA (see src/App.jsx). Proxying every request under these
    # two prefixes straight to the backend unconditionally - as the next
    # location block below still correctly does for auth/media/rooms/etc,
    # none of which are ever a real page URL - meant a genuine full-page
    # load of /destinations (typed into the address bar, refreshed,
    # opened from a bookmark or a shared link) got the backend's raw JSON
    # instead of the app shell (index.html) that boots React Router,
    # which is the only thing that actually knows how to render that
    # route client-side.
    #
    # THE SIGNAL: Accept, and ONLY Accept
    # -----------------------------------------------------------------
    # Two earlier attempts at this fix both used Sec-Fetch-Dest, either
    # alone or alongside Accept as an extra "just in case" check. Both
    # failed in real-browser testing - not intermittently, but
    # consistently, because this app's service worker
    # (public/service-worker.js) intercepts EVERY same-origin GET,
    # including the app's own fetch('/destinations') calls, and re-issues
    # them via its own fetch(request) call. Chrome sets Sec-Fetch-Dest to
    # "document" on THAT relayed request regardless of what the original
    # request's destination actually was - so with Sec-Fetch-Dest in the
    # check (even only as one half of an OR), the app's own API calls
    # were misidentified as page navigations and got served index.html's
    # HTML instead of JSON, which is a worse failure than the original
    # bug: "Couldn't load places: Unexpected token '<' ... is not valid
    # JSON" on every single page load, not just on refresh.
    #
    # Accept does not have this problem, because it is set once, by the
    # browser, at the moment the ORIGINAL request is constructed -
    # before the service worker ever sees it - and is carried through
    # unchanged by fetch(request) no matter how many hands the request
    # passes through afterwards. A real top-level browser navigation
    # always sends an Accept value STARTING WITH "text/html" (every
    # major browser does this); this app's own JS calls
    # (src/api/client.js) never set an Accept header at all, so the
    # browser's fetch() default goes out instead, which never contains
    # "text/html" anywhere in it. This is now the ONLY signal used here -
    # do not add Sec-Fetch-Dest back next to it, for the reason above.
    location ~ ^/(destinations|favorites)(/|$) {
        if ($http_accept ~* "text/html") {
            rewrite ^ /index.html last;
        }

        proxy_pass http://127.0.0.1:8105;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Everything else under these prefixes is never a real page URL (no
    # React Router route starts with any of these - the SPA's own pages
    # are /itinerary, /ai-chat, /chat, /for-you, /profile, etc, not these
    # backend-only path names), so it's always safe to proxy straight
    # through regardless of how the request was made.
    location ~ ^/(auth|preferences|users|itineraries|routing|media|assistant|rooms|recommendations)(/|$) {
        proxy_pass http://127.0.0.1:8105;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /ws/ {
        proxy_pass http://127.0.0.1:8105;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri /index.html;
    }
}
